package com.flipkart.krystal.keka.samples.products;

vajram computeAveragePrice in (ProductCollection collection) out `now double?{

  ProductDetails?... productDetails =... getProductDetails(
      productId =... collection.productIds();
  );

  {
    productDetails.values()
      .stream()
      .filter(_?valuePresent())
      .map(_.price())
      .mapToDouble()
      .average()
  }
}
