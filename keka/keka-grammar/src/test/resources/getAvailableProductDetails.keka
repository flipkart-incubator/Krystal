package com.flipkart.krystal.keka.samples.products;

vajram getAvailableProductDetails
    in (string productId)
    out ProductDetails?~ {

  bool? isAvailable = isProductAvailable(productId = productId);

  out getProductDetails(productId = productId)
        ?default{ new ProductDetails(productId) }
      `skipIf(reason="Product is not available.")
      { isAvailable? eq false };
}
