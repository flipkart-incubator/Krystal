package com.flipkart.krystal.keka.samples.friends;

import vajram Set from java.lang;
import vajram FriendServiceClient from com.flipkart.krystal.keka.samples.friendsservice;

vajram getFriendsOfUser
    (string userId)
    out Set<string>
    inject (FriendServiceClient svcClient)
    permit callers public {

  out ~{
    svcClient.getFriendsIds(
        new FriendServiceRequest(
            #batch().stream()
                .map{_.userId()}
                .toSet()))
      ~?.results()
      ~? default(List.of())
      ~ .stream()
      ~ .toMap {
          new #batch(_.userId()), _.friendIds()}
  }
}
