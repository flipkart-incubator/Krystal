package keka_samples.hello;

// Run: ./gradlew :keka:keka-samples:runVajram -Pvajram=helloWorld2
vajram helloWorld2
    in (string name)
    out `now string
    permit
      callers `outsideProcess public {
  string greeting = concatTwoStrings(first = "Hello again from keka, "; second = name);

  { greeting + "!" }
}
