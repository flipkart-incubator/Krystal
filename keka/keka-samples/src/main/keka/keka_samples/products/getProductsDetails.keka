package keka_samples.products;

import vajram concatStrings from lang.strings;

// Fans out getProductDetails over every product id, then joins the results.
vajram getProductsDetails(List<string> productIds)
    out string {

  string... details = ...getProductDetails(productId =... productIds);

  string joined = concatStrings(strings = details; separator = ", ");

  { joined }
}
