#TODO Testcases: A, A!, [A], [A!], [A!]! -> 4 types of As (Scalars, entities, entityExtensions, types)
"""
An order
"""
type Order @entity @subPackage(name: "order"){
    id: ID! @idField
    """
    List of order Item names in this order
    """
    orderItemNames: [String] @dataFetcher(vajramId: "GetOrderItemNames", subPackage: "order", multiField: true)
    nameString: String @dataFetcher(vajramId: "GetOrderItemNames", subPackage: "order", multiField: true)
    orderPlacedAt: DateTime @dataFetcher(vajramId: "GetOrderSummary", subPackage: "order", multiField: true)
    orderItemsCount: Long! @dataFetcher(vajramId: "GetOrderSummary", subPackage: "order", multiField: true)
    orderAcceptDate: Date @dataFetcher(vajramId: "GetOrderSummary", subPackage: "order", multiField: true)
    dummy(name: String): Dummy @idFetcher(vajramId: "GetDummyIdForOrder", subPackage: "order")
    dummies(filter: Boolean, preferredType: String, count: Int): [Dummy!]! @idFetcher(vajramId: "GetDummyIds", subPackage: "order")
    hello: Hello @inferIdFromParent
    recommendedOrders: [Order]
    state: State @dataFetcher(vajramId: "GetOrderState", subPackage: "order")
    stateDuplicate: State @dataFetcher(vajramId: "GetOrderState", subPackage: "order")
    name: Name #@dataFetcher(vajramId: "GetName")

    #TODO: Add check that fields with @inferIdFromParent must be @entityExtensions
    #TODO: Add check that fields with @entityExtensions cannot be fanout types
    #hellos: [Hello] @inferIdFromParent
}

enum State {
    PENDING
    COMPLETED
}

type Dummy @entity{
    dummyId: ID! @idField
    name: String!
    age: Int
    order: Order
    f1: String
}

#TODO Testcase: Can be used inside Order entity only - using inside any other entity throws error
#TODO Testcase: Will be aggregated if @inferIdFromParent is present on field- in which case the composing entity's id is used for aggregation (Fanout should not be possible)
#TODO Testcase: Using idFetcher on entityExtensions is an error
#TODO Testcase: ?? Can @composedEntities be allowed as lists or only single (canFanout or not?)
type Hello @entityExtension(ofEntity: "Order"){
    toName: String
}

type Name {
    value: String @idField
    string: String @idField
}

