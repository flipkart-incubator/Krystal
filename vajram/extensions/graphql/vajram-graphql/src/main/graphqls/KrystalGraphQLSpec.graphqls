"""

"""
directive @entity on OBJECT

"""
Marks a field as part of the identity of its containing GraphQL type.
"""
directive @idField on FIELD_DEFINITION

"""
Specifies the vajram responsible for fetching data for one or more fields of a GraphQL type.
By default, its response is assigned directly to the annotated field. Set multiField to true
when the vajram returns an aggregate response: each field using the same vajramId receives the
value from the correspondingly named field in that response. multiField defaults to false.
Data fetchers can be used only for Scalar types and simple types. Using them on fields of type
entity or composedType throws an error.
"""
#TODO: Validation: Throw error if used with entity or composedType
directive @dataFetcher(vajramId : String!, subPackage: String, multiField: Boolean = false) on FIELD_DEFINITION

"""
Specifies the vajram which is responsible for fetching the identity of a GraphQL object.
This is useful when a field depicts a one-to-one or one-to-many relationship between GraphQL objects.
For example, if an entity of type Book has a field "author" of type Author, an @idFetcher vajram returns Author_Id.
"""
#TODO: TEst case: Should support fanout and one2one
directive @idFetcher(vajramId : String!, subPackage: String) on FIELD_DEFINITION


"""
This means the identity used for type aggregation should be taken from the arguments passed to the field.
Only valid on fields of root operation types where the field type has a single @idField.
"""
#TODO Validation: inferIdFromArgs can only be present in fields inside root operation types
directive @inferIdFromArgs on FIELD_DEFINITION

"""
Specifies that the id of the parent entity should be used to aggregate the given field.
Using this directive on a field is only valid if the field type is an Object type
with the directive @composedType whose "inEntity" argument matches the composing entity type
"""
#TODO: Validation: throw error if used in non-@composedType
#TODO: Validation: throw error if used with lists (fanout should not be supported)
directive @inferIdFromParent on FIELD_DEFINITION

"""
Specifies the Java type mapping for a GraphQL scalar type.

Example:
  scalar Timestamp
    @specifiedBy(url: "https://scalars.graphql.org/andimarek/date-time.html")
    @javaType(packageName: "java.time", className: "OffsetDateTime")

  type Order {
    createdAt: Timestamp    # Will be mapped to java.time.OffsetDateTime
  }
"""
directive @javaType(packageName : String!, className: String!) on SCALAR

"""
Specifies the root package under which all data fetchers and id fetchers vajrams are located.
If a vajram is located in a subpackage inside the root package,
the sub package suffix can be specified separately in the @dataFetcher and @idFetcher directives.
"""
directive @rootPackage(name: String!) on SCHEMA

"""
Specifies the sub package inside @rootPackage under which all the models corresponding to an object are to be generated
"""
directive @subPackage(name: String!) on OBJECT

"""
Specifies that a given non-entity type can be composed inside an entity of type entityType.
This means that any @dataFetchers or @idFetchers on the fields of the type must accept
the composing entity's _Id and compute the values of the fields based on it.
Note: an instance of a composed type has a one to one correspondence with a given order id.
"""
#TODO: Validation: Can be used only on @entity fields and @composedType fields.
#TODO: Validation: When used in @composedTypes, the "inEntity" must match the outer "inEntity"
directive @composedType(inEntity: String!) on OBJECT
