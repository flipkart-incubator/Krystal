package com.flipkart.krystal.vajram_lang.samples.friends;

import java.lang.Set;
import com.flipkart.krystal.vajram_lang.samples.friendsservice.FriendServiceClient;

public vajram getFriendsOfUser
    (string userId)
    out Set<string>
    inject (FriendServiceClient svcClient){

  out ~{
    svcClient.getFriendsIds(
        new FriendServiceRequest(
            #mod().stream()
                .map{_.userId()}
                .toSet()))
      ~?.results()
      ~? default(List.of())
      ~ .stream()
      ~ .toMap {
          new #mod(_.userId()), _.friendIds()}
  }
}