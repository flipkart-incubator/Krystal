package com.flipkart.krystal.vajram_lang.samples.friends;

import java.lang.Set;
import com.flipkart.krystal.vajram_lang.samples.friends.getFriendIdsOfUser;
import com.flipkart.krystal.vajram_lang.samples.friends.getUserInfo;

public vajram sayHelloToFriendsV2
    (string userId)
    out string{

  UserInfo userInfo = getUserInfo(userId = userId);

  Set<string> friendIds = getFriendIdsOfUser(userId = userId);

  UserInfo* friendInfos = getUserInfo(userId =* friendIds);

  out {
    yield "Hello Friends of %s ! %s"
       .formatted(
           userInfo.name(),
           friendInfos.stream()
               .filter(_.isPresent())
               .map(_.userName())
               .collect(joining(", ")));
  }
}