package com.flipkart.krystal.vajram_lang.samples.friends;

import com.flipkart.userservice.models.UserServiceClient;

private vajram getUserInfo
    (#batch string userId)
    out UserInfo
    permits sayHelloToFriends
    inject (UserServiceClient svcClient) {

  out ~{
    svcClient.getUserInfos(
        UserServiceClient.makeUserInfoRequest(
            #mod().stream()
                .map(_.userId())
                .toSet()))
      ~?.userInfos()
      ~?.stream()
      ~? default(Stream.of())
      ~ .toMap {
          new #mod(_.userId()), _
        }
  }
}