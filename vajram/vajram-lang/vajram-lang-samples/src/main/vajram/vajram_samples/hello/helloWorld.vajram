package vajram_samples.hello;

import type ConsoleWriter from lang.process;

// Run: ./gradlew :vajram:vajram-lang:vajram-lang-samples:runVajram -Pvajram=helloWorld
vajram helloWorld() out void
    inject (ConsoleWriter writer)
    permit callers `outsideProcess public {
  {
    writer.println("Hello! World.")
  }
}
