package vajram_samples.hello;

import vajram readFileAsString from lang.FileSystem;

// Run:
// ./gradlew :vajram:vajram-lang:vajram-lang-samples:runVajram -Pvajram=headFile
//    -PvajramArgs="--numChars 5 --filePath /path/to/file"
vajram headFile(int numChars, string filePath)
    out string~
    permit callers `outsideProcess public{
  string fileContent = readFileAsString(path = filePath);

  out ~{
    yield fileContent.first(numChars);
  }
}
