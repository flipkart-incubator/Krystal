package com.flipkart.krystal.vajram_lang.samples.products;

vajram computeAveragePrice in (ProductCollection collection) out double?{

  ProductDetails?* productDetails =* getProductDetails(
      productId =* collection.productIds();
  );

  ~ {
    productDetails.values()
      .stream()
      .filter(_?valuePresent())
      .map(_.price())
      .mapToDouble()
      .average()
  }
}
